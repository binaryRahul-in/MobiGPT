{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "__tests__/**/*.ts", "__tests__/**/*.tsx", "packages/*/src/**/*.ts", "jest/**/*.ts", "*.d.ts"],
  "exclude": ["**/node_modules", "**/Pods", "android", "ios"]
}
